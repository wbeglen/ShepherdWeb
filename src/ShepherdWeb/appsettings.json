{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Urls": "https://localhost:7240;http://localhost:5240",
  "ShepherdApi": {
    "BaseUrl": "http://localhost:5231",
    "TimeoutSeconds": 30
  },
  "ArtifactStore": {
    "RootPath": "%LOCALAPPDATA%/GoodShepherd/Artifacts",
    "MaxUploadBytes": 52428800
  },
  "Conventions": {
    "DraftStatusName": "Draft",
    "LockedStatusName": "Locked",
    "RetiredStatusName": "Retired",
    "DefaultExecutionStatusName": "Draft",
    "DeliveredPromptArtifactTypeName": "DeliveredPrompt"
  }
}
