@inject ShepherdApi.IExperimentVersionsClient Versions
@inject ReferenceData ReferenceData
@inject ApiErrorMapper Errors
@inject IOptions<ConventionsOptions> Conventions

<ProblemDisplay Problem="problem" />

<dl class="row mb-4">
    <dt class="col-sm-3">Effective</dt>
    <dd class="col-sm-9"><UtcTimestamp Value="Version.EffectiveDateUTC" /></dd>
    <dt class="col-sm-3">Locked</dt>
    <dd class="col-sm-9"><UtcTimestamp Value="Version.LockedUTC" Missing="not locked" /></dd>
    <dt class="col-sm-3">Executions</dt>
    <dd class="col-sm-9">@Configuration.ExecutionCount (@InProgressCount in progress)</dd>
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9 text-prewrap">@Version.Description</dd>
</dl>

<div class="d-flex flex-wrap gap-2 mb-4">
    @if (!Configuration.IsConfigurationFrozen)
    {
        <a class="btn btn-outline-primary" href="versions/@Version.ExperimentVersionID/edit">Edit details</a>
    }
    <a class="btn btn-outline-primary" href="versions/@Version.ExperimentVersionID/review">Review configuration</a>
    @if (!VersionLifecycle.IsLocked(Version))
    {
        <button class="btn btn-danger ms-auto" disabled="@(InProgressCount > 0)" @onclick="() => confirmingLock = true">Lock version…</button>
    }
</div>
@if (!VersionLifecycle.IsLocked(Version) && InProgressCount > 0)
{
    @* ShepherdAPI refuses to finalize while any execution is open (finalize-execution-not-ended). *@
    <p class="text-secondary small">
        @InProgressCount execution@(InProgressCount == 1 ? " is" : "s are") still in progress. End @(InProgressCount == 1 ? "it" : "them") before locking.
    </p>
}

<section class="form-narrow">
    <h2 class="h6">Status</h2>
    <div class="input-group">
        <select class="form-select" aria-label="Status" @bind="selectedStatusId">
            @foreach (var status in offerable)
            {
                <option value="@status.StatusID">@status.Name</option>
            }
        </select>
        <button class="btn btn-outline-secondary" disabled="@(saving || selectedStatusId == Version.StatusID)" @onclick="SetStatusAsync">
            Change status
        </button>
    </div>
    <div class="form-text">
        @if (VersionLifecycle.IsLocked(Version))
        {
            <text>Status can still change after locking. It does not unlock anything.</text>
        }
        else
        {
            <text>“@Conventions.Value.LockedStatusName” is set only by the Lock action, right after the version is locked.</text>
        }
    </div>
</section>

@* Lock is the final immutability boundary (docs/ARCHITECTURE.md §3 rule 4, revision 4). ShepherdAPI's lock
   runs finalization: it checks the version is complete, snapshots every score and sets LockedUTC, or
   changes nothing and says why (finalize-*). It no longer sets the status, so ShepherdWeb sets
   "Locked" in a second call (owner decision D1); LockedUTC stays authoritative. *@
<ConfirmDialog Visible="confirmingLock" Title="Lock this version?" ConfirmText="Lock permanently" ConfirmClass="btn-danger"
               Busy="saving" OnConfirm="LockAsync" OnCancel="() => confirmingLock = false">
    <p><strong>@Version.Name @Version.VersionLabel</strong></p>
    <ul>
        <li>@Configuration.Iterations.Count iterations, @Configuration.ExecutionCount executions</li>
        <li>ShepherdAPI first checks that the version is complete (every execution ended and scored, rule weights total 100 per phase). If not, nothing changes and it says why.</li>
        <li>Every score is copied into a permanent snapshot.</li>
        @if (lockStatus is not null)
        {
            <li>Status is then set to “@lockStatus.Name”.</li>
        }
        else
        {
            <li class="text-warning-emphasis">There is no “@Conventions.Value.LockedStatusName” status, so the status will not change. Create it under Reference data.</li>
        }
    </ul>
    <p class="mb-0">
        Everything becomes permanent: configuration, executions, artifacts, scores and evidence. No further executions can be started.
        <strong>This cannot be undone through ShepherdWeb or ShepherdAPI.</strong>
    </p>
</ConfirmDialog>

@code {
    [Parameter, EditorRequired] public VersionConfiguration Configuration { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private ShepherdApi.ExperimentVersion Version => Configuration.Version;
    private int InProgressCount => Configuration.Executions.Count(e => e.EndUTC is null);
    private IReadOnlyList<ShepherdApi.Status> offerable = [];
    private ShepherdApi.Status? lockStatus;
    private int selectedStatusId;
    private ApiProblem? problem;
    private bool saving;
    private bool confirmingLock;

    protected override void OnParametersSet()
    {
        offerable = VersionLifecycle.OfferableStatuses(Version, ReferenceData.Statuses, Conventions.Value);

        // A mismatched current status (e.g. "Locked" without a lock) is not offerable; show it
        // anyway so the select reflects reality instead of silently picking another value.
        if (offerable.All(s => s.StatusID != Version.StatusID) &&
            ReferenceData.Statuses.FirstOrDefault(s => s.StatusID == Version.StatusID) is { } current)
        {
            offerable = [current, .. offerable];
        }

        selectedStatusId = Version.StatusID;
        lockStatus = ReferenceData.FindStatus(Conventions.Value.LockedStatusName);
    }

    private async Task SetStatusAsync()
    {
        saving = true;
        problem = null;
        try
        {
            await Versions.StatusAsync(Version.ExperimentVersionID, new ShepherdApi.SetExperimentVersionStatusRequest { StatusID = selectedStatusId });
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ApiErrorMapper.IsApiFailure(ex))
        {
            problem = Errors.Map(ex);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task LockAsync()
    {
        saving = true;
        problem = null;
        try
        {
            ShepherdApi.ExperimentVersion locked;
            try
            {
                // ShepherdAPI ignores StatusID on lock; none is sent.
                locked = await Versions.LockAsync(Version.ExperimentVersionID, new ShepherdApi.LockExperimentVersionRequest());
            }
            catch (Exception ex) when (ApiErrorMapper.IsApiFailure(ex))
            {
                problem = Errors.Map(ex); // e.g. "Finalization Failed: Execution Not Ended", with the IDs in Detail
                return;
            }

            // Finalization succeeded and is permanent. Synchronize the status; never retry the lock.
            if (lockStatus is not null && locked.StatusID != lockStatus.StatusID)
            {
                try
                {
                    await Versions.StatusAsync(Version.ExperimentVersionID, new ShepherdApi.SetExperimentVersionStatusRequest { StatusID = lockStatus.StatusID });
                }
                catch (Exception ex) when (ApiErrorMapper.IsApiFailure(ex))
                {
                    var failure = Errors.Map(ex);
                    problem = failure with
                    {
                        Title = "Locked, but the status was not updated",
                        Detail = $"Finalization succeeded: this version was locked at {Utc.Format(locked.LockedUTC ?? Utc.Now)} and that cannot be undone. " +
                                 $"Setting its status to “{lockStatus.Name}” failed ({failure.Title}: {failure.Detail}). " +
                                 $"Use Change status to set it.",
                    };
                }
            }

            await OnChanged.InvokeAsync(); // Reload: the whole page becomes read-only.
        }
        finally
        {
            saving = false;
            confirmingLock = false;
        }
    }
}
