@page "/executions/{ExecutionId:long}"
@inject ExecutionLoader Loader
@inject StartExecutionWorkflow Workflow
@inject ArtifactRegistrar Registrar
@inject ReferenceData ReferenceData
@inject ApiErrorMapper Errors
@inject IJSRuntime JS
@inject IOptions<ConventionsOptions> Conventions

<PageTitle>Execution @ExecutionId · ShepherdWeb</PageTitle>

<ProblemDisplay Problem="problem" OnRetry="LoadAsync" />

@if (view is { } v)
{
    var e = v.Execution;
    <VersionHeader Version="v.Version" Current="@($"Execution #{e.ExecutionID}")" />

    <div class="d-flex align-items-baseline gap-2 mb-2">
        <h2 class="h5 mb-0">Execution #@e.ExecutionID</h2>
        @if (v.HasEnded)
        {
            <span class="badge text-bg-secondary">ended</span>
        }
        else
        {
            <span class="badge text-bg-primary">in progress</span>
        }
        @if (e.InterventionCount > 0)
        {
            <span class="badge text-bg-warning">⚑ @e.InterventionCount intervention@(e.InterventionCount == 1 ? "" : "s")</span>
        }
    </div>

    <dl class="row mb-3">
        <dt class="col-sm-2">Iteration</dt>
        <dd class="col-sm-10"><a href="versions/@v.Version.ExperimentVersionID/iterations/@v.Iteration.IterationID">@v.Iteration.Sequence. @v.Iteration.IterationLabel</a></dd>
        <dt class="col-sm-2">Agent</dt><dd class="col-sm-10">@ReferenceData.AgentName(e.AgentID)</dd>
        <dt class="col-sm-2">Phase</dt><dd class="col-sm-10">@ReferenceData.PhaseName(e.PhaseID)</dd>
        <dt class="col-sm-2">Attempt</dt><dd class="col-sm-10">@e.AttemptNumber</dd>
        <dt class="col-sm-2">Model / interface</dt><dd class="col-sm-10">@(e.ModelUsed ?? "—") / @(e.InterfaceUsed ?? "—")</dd>
        <dt class="col-sm-2">Started</dt><dd class="col-sm-10"><UtcTimestamp Value="e.StartUTC" /></dd>
        <dt class="col-sm-2">Ended</dt><dd class="col-sm-10"><UtcTimestamp Value="e.EndUTC" Missing="in progress" /></dd>
        @if (!string.IsNullOrWhiteSpace(e.OutcomeNotes))
        {
            <dt class="col-sm-2">Outcome notes</dt><dd class="col-sm-10 text-prewrap">@e.OutcomeNotes</dd>
        }
        @if (!string.IsNullOrWhiteSpace(e.ArtifactURI))
        {
            <dt class="col-sm-2">Artifact URI <span class="badge text-bg-light">legacy</span></dt><dd class="col-sm-10">@e.ArtifactURI</dd>
        }
    </dl>

    @* ---- Start prompt (AD-8: identified by provenance, verified before release) ---- *@
    <section class="mb-4">
        <h3 class="h6">Delivered prompt</h3>
        @if (v.DeliveredPromptTypeId is null)
        {
            <div class="alert alert-danger py-2">There is no “@Conventions.Value.DeliveredPromptArtifactTypeName” artifact type, so the prompt cannot be registered. Create it under Reference data.</div>
        }
        else if (v.StartPrompts.Count == 0)
        {
            <div class="alert alert-danger py-2">
                <strong>No start prompt is registered for this execution.</strong> The prompt cannot be copied until it is.
            </div>
            @if (pendingChecked && !VersionLifecycle.IsLocked(v.Version))
            {
                @if (pendingLookup?.Usable is { } pending)
                {
                    // Exactly what was decided at Start: shown, never editable, registered with the saved provenance.
                    var text = new PromptText(pending.Text);
                    <section class="small mb-2" aria-label="Prompt to register">
                        <div class="text-secondary">
                            Saved when this execution was started, with provenance
                            “@(pending.IsOverride ? "edited for this execution before Start" : "the iteration's prompt")”.
                            Exactly this text will be registered.
                        </div>
                        <pre class="prompt-view prompt-preview mb-1">@pending.Text</pre>
                        <div class="text-secondary mb-2">
                            @text.CharacterCount characters · @text.LineCount lines · @text.ByteCount bytes (UTF-8) · SHA-256 <Sha256Display Value="@text.Sha256" />
                        </div>
                        <button class="btn btn-sm btn-danger" disabled="@busy" @onclick="() => RegisterPendingStartPromptAsync(pending)">Register it now</button>
                    </section>
                }
                else
                {
                    // Fix 6 (owner decision): if the exact prompt from Start cannot be established, no substitute is offered.
                    <div class="small mb-2" role="status">
                        <p class="mb-1">@pendingLookup?.Problem</p>
                        <p class="mb-1">
                            ShepherdWeb cannot establish the exact prompt this execution was started with, so it will not register
                            any prompt for it. This execution remains incomplete and is kept as it is.
                        </p>
                        <p class="mb-0">
                            To proceed, <a href="versions/@v.Version.ExperimentVersionID/executions/new?iterationId=@v.Iteration.IterationID">start a new attempt</a>.
                            You can record what happened in this execution's outcome notes.
                        </p>
                    </div>
                }
            }
        }
        else if (v.StartPrompts.Count > 1)
        {
            <div class="alert alert-danger py-2">
                <strong>@v.StartPrompts.Count start prompts are registered for this execution.</strong>
                None is released for copying.
            </div>
            <ul class="small">
                @foreach (var start in v.StartPrompts)
                {
                    <li><UtcTimestamp Value="start.ReceivedUTC" /> · <code>@start.OriginalURI</code> · SHA-256 <Sha256Display Value="@(start.ShA256 ?? "")" /></li>
                }
            </ul>
        }
        else
        {
            var start = v.StartPrompts[0];
            <div class="small text-secondary mb-2">
                Registered <UtcTimestamp Value="start.ReceivedUTC" /> · SHA-256 <Sha256Display Value="@(start.ShA256 ?? "")" />
                @if (PromptProvenance.IsExecutionStartUri(start.OriginalURI, e.ExecutionID))
                {
                    <span class="ms-2">Provenance: edited for this execution before Start.</span>
                }
                else if (!string.Equals(start.ShA256, iterationPromptSha, StringComparison.OrdinalIgnoreCase))
                {
                    // Observed fact only: the two hashes differ. No cause is inferred.
                    <span class="text-danger ms-2">
                        ⚠ The registered start prompt (SHA-256 <Sha256Display Value="@(start.ShA256 ?? "")" />) differs from this iteration's
                        current prompt (SHA-256 <Sha256Display Value="@iterationPromptSha" />).
                    </span>
                }
            </div>
            @if (startPromptText.Problem is { } integrityProblem)
            {
                <div class="alert alert-danger py-2" role="alert">@integrityProblem The prompt is not displayed or released for copying.</div>
            }
            else
            {
                @if (v.CanEditRunFacts)
                {
                    <button class="btn btn-primary" @onclick="() => CopyAsync(start)">Copy prompt</button>
                    <span class="ms-2 small">@copyMessage</span>
                }
                <details class="mt-2">
                    <summary class="small">Show the registered prompt (verified)</summary>
                    <pre class="prompt-view prompt-preview">@startPromptText.Text</pre>
                </details>
            }
        }

        @if (v.InterventionPrompts.Count > 0)
        {
            <h4 class="h6 mt-3">Additional prompts delivered during interventions</h4>
            <ul class="small">
                @foreach (var extra in v.InterventionPrompts)
                {
                    <li><UtcTimestamp Value="extra.ReceivedUTC" /> · <Sha256Display Value="@(extra.ShA256 ?? "")" /> · <a href="artifact-files/@extra.ArtifactID" target="_blank" rel="noopener">view (not verified)</a></li>
                }
            </ul>
        }

        @if (v.UnrecordedRolePrompts.Count > 0)
        {
            <h4 class="h6 mt-3">Delivered prompts with no recognised role</h4>
            <ul class="small">
                @foreach (var other in v.UnrecordedRolePrompts)
                {
                    <li><UtcTimestamp Value="other.ReceivedUTC" /> · <code>@(other.OriginalURI ?? "(no OriginalURI)")</code> · <Sha256Display Value="@(other.ShA256 ?? "")" /></li>
                }
            </ul>
        }
    </section>

    @* ---- In progress: hands off ---- *@
    @if (v.CanEditRunFacts)
    {
        @if (mode == Mode.Ending || mode == Mode.Editing)
        {
            <RunFactsEditor Execution="e" Ending="@(mode == Mode.Ending)" OnSaved="SavedAsync" OnCancel="() => mode = Mode.None" />
        }
        else if (mode == Mode.AdditionalPrompt)
        {
            <section class="border rounded p-3 mb-3 form-narrow">
                <h3 class="h6">Deliver additional prompt (intervention)</h3>
                <p class="small text-secondary">
                    Only when something unexpected needs human action. The exact text is registered as a delivered prompt before
                    you can copy it. Record the intervention itself when the execution ends.
                </p>
                <textarea class="form-control prompt-editor mb-2" rows="6" @bind="additionalPrompt" @bind:event="oninput"></textarea>
                <button class="btn btn-sm btn-warning" disabled="@(busy || string.IsNullOrWhiteSpace(additionalPrompt))" @onclick="RegisterAdditionalPromptAsync">Register prompt</button>
                <button class="btn btn-sm btn-link" @onclick="() => mode = Mode.None">Cancel</button>
            </section>
        }
        else
        {
            <p class="text-secondary">
                Hands off: the agent is running. When it finishes, record the end.
            </p>
            <div class="d-flex flex-wrap gap-2 mb-4">
                <button class="btn btn-primary" @onclick="() => mode = Mode.Ending">Execution ended…</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => mode = Mode.Editing">Edit run facts</button>
                @* An intervention prompt only makes sense after a start prompt exists (finding 2). *@
                <button class="btn btn-outline-warning btn-sm" disabled="@(v.StartPrompts.Count == 0)"
                        title="@(v.StartPrompts.Count == 0 ? "Available once a start prompt is registered" : null)"
                        @onclick="() => mode = Mode.AdditionalPrompt">Deliver additional prompt (intervention)…</button>
            </div>
        }

        @if (lastAdditional is not null)
        {
            <div class="alert alert-info py-2">
                Additional prompt registered.
                <button class="btn btn-sm btn-primary ms-2" @onclick="() => CopyAsync(lastAdditional)">Copy it</button>
                <span class="ms-2 small">@copyMessage</span>
            </div>
        }
    }
    else if (!v.HasEnded)
    {
        <div class="alert alert-secondary">The version was locked while this execution was in progress. It can no longer be ended or scored.</div>
    }

    @* ---- Ended: evaluation ---- *@
    @if (v.HasEnded)
    {
        <section class="mb-4">
            <div class="d-flex align-items-baseline gap-3">
                <h3 class="h6 mb-2">Evaluation</h3>
                <a class="small" href="executions/@e.ExecutionID/scoring">@(v.CanEvaluate ? "Score this execution" : "View scores")</a>
            </div>
            <ArtifactList ExecutionId="e.ExecutionID" Artifacts="v.EvaluationArtifacts" CanUpload="v.CanEvaluate" OnChanged="LoadAsync" />
        </section>
    }
}
else if (problem is null)
{
    <p>Loading…</p>
}

@code {
    [Parameter] public long ExecutionId { get; set; }

    private enum Mode { None, Ending, Editing, AdditionalPrompt }

    private ExecutionView? view;
    private ApiProblem? problem;
    private Mode mode;
    private bool busy;
    private VerifiedText startPromptText = new(IntegrityResult.Missing, null);
    private string iterationPromptSha = string.Empty;
    private string additionalPrompt = string.Empty;
    private ShepherdApi.Artifact? lastAdditional;
    private string? copyMessage;
    private long loadedId;

    // Retry of a start prompt that was never registered: the pending prompt saved in this browser at
    // Start, if it can be established that it belongs to this execution record. Read after the first
    // render (browser storage needs JS interop).
    private PendingStartPromptLookup? pendingLookup;
    private bool pendingChecked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (view is null || pendingChecked || view.StartPrompts.Count != 0)
        {
            return;
        }

        pendingChecked = true;
        pendingLookup = await Workflow.FindPendingStartPromptAsync(view.Execution);
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId != ExecutionId)
        {
            loadedId = ExecutionId;
            view = null;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        problem = null;
        pendingChecked = false;
        pendingLookup = null;
        try
        {
            view = await Loader.LoadAsync(ExecutionId);
            iterationPromptSha = new PromptText(view.Iteration.Prompt).Sha256;

            // Only a single, unambiguous start prompt is read, and only verified bytes are ever shown or copied.
            startPromptText = view.StartPrompts.Count == 1
                ? await Registrar.ReadVerifiedTextAsync(view.StartPrompts[0])
                : new VerifiedText(IntegrityResult.Missing, null);
        }
        catch (Exception ex) when (ApiErrorMapper.IsApiFailure(ex))
        {
            problem = Errors.Map(ex);
        }
    }

    private async Task SavedAsync()
    {
        mode = Mode.None;
        lastAdditional = null;
        await LoadAsync();
    }

    private Task RegisterPendingStartPromptAsync(PendingStartPrompt pending) => RunAsync(async () =>
    {
        await Workflow.RegisterStartPromptAsync(pending);
        await LoadAsync();
    });

    private Task RegisterAdditionalPromptAsync() => RunAsync(async () =>
    {
        var artifact = await Workflow.RegisterAdditionalPromptAsync(ExecutionId, additionalPrompt);
        additionalPrompt = string.Empty;
        mode = Mode.None;
        await LoadAsync();
        lastAdditional = artifact;
        copyMessage = null;
    });

    // What is copied is read back from the store and verified against the recorded SHA-256 (AD-8).
    private async Task CopyAsync(ShepherdApi.Artifact artifact)
    {
        var verified = await Registrar.ReadVerifiedTextAsync(artifact);
        if (verified.Text is null)
        {
            copyMessage = verified.Problem + " Nothing was copied.";
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", verified.Text);
            copyMessage = $"Copied at {Utc.Format(Utc.Now)}.";
        }
        catch (JSException)
        {
            copyMessage = "The browser refused clipboard access. Open “Show the registered prompt” and copy it manually.";
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        problem = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (StartExecutionWorkflow.IsRegistrationFailure(ex))
        {
            problem = ApiErrorMapper.IsApiFailure(ex)
                ? Errors.Map(ex)
                : new ApiProblem(ApiProblemKind.Unexpected, "Prompt not registered", ex.Message);
        }
        finally
        {
            busy = false;
        }
    }
}
