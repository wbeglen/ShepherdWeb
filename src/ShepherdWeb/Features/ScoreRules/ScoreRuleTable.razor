@* The Score rules tab of a version: rules grouped by phase, in phase order. Rules are added and deleted
   here; ShepherdAPI deletes physically and frees the phase and category (Issue #7). Editing through
   PUT /api/score-rules/{id} is deferred: a mistaken rule is deleted and added again. Both are offered
   only until the first execution (design freeze) or lock. ScoreRule.Active is not shown or used (owner
   decision N2), and no weight totals are computed (N3). *@
@inject ShepherdApi.IScoreRulesClient ScoreRules
@inject ReferenceData ReferenceData
@inject ApiErrorMapper Errors

<ProblemDisplay Problem="problem" />

@if (Configuration.ScoreRules.Count == 0)
{
    <p class="text-secondary">No score rules yet.</p>
}

@foreach (var group in Groups())
{
    <h2 class="h6 mt-3">@group.PhaseName</h2>
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Category</th><th>Better</th><th class="text-end">Weight %</th><th class="text-end">Min</th><th class="text-end">Max</th><th>Notes</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rule in group.Rules)
            {
                <tr>
                    <td>@ReferenceData.ScoreCategoryName(rule.ScoreCategoryID)</td>
                    <td>@Better(rule.ScoreCategoryID)</td>
                    <td class="text-end">@rule.WeightPercent.ToString("0.##")</td>
                    <td class="text-end">@rule.MinScore</td>
                    <td class="text-end">@rule.MaxScore</td>
                    <td class="small">@rule.RuleNotes</td>
                    <td class="text-end">
                        @if (!locked)
                        {
                            <button class="btn btn-sm btn-link text-danger" @onclick="() => deleting = rule">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!locked)
{
    <section class="border rounded p-3 mt-3 form-narrow">
        <h2 class="h6">Add score rule</h2>
        <EditForm Model="form" OnValidSubmit="AddAsync">
            <DataAnnotationsValidator />
            <ApiValidation @ref="apiValidation" />
            <ValidationSummary />

            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label" for="rule-phase">Phase</label>
                    <InputSelect id="rule-phase" class="form-select" @bind-Value="form.PhaseID">
                        <option value="0">Choose…</option>
                        @foreach (var phase in ReferenceData.Phases)
                        {
                            <option value="@phase.PhaseID">@phase.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-6">
                    <label class="form-label" for="rule-category">Category</label>
                    <InputSelect id="rule-category" class="form-select" @bind-Value="form.ScoreCategoryID">
                        <option value="0">Choose…</option>
                        @foreach (var category in ReferenceData.ScoreCategories)
                        {
                            var taken = form.ExistingPairs.Contains((form.PhaseID, category.ScoreCategoryID));
                            <option value="@category.ScoreCategoryID" disabled="@taken">
                                @category.Name (@(category.HigherIsBetter ? "higher" : "lower") is better)@(taken ? " · already has a rule" : "")
                            </option>
                        }
                    </InputSelect>
                </div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-4">
                    <label class="form-label" for="rule-weight">Weight %</label>
                    <InputNumber id="rule-weight" class="form-control" step="0.01" @bind-Value="form.WeightPercent" />
                </div>
                <div class="col-4">
                    <label class="form-label" for="rule-min">Min score</label>
                    <InputNumber id="rule-min" class="form-control" @bind-Value="form.MinScore" />
                </div>
                <div class="col-4">
                    <label class="form-label" for="rule-max">Max score</label>
                    <InputNumber id="rule-max" class="form-control" @bind-Value="form.MaxScore" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="rule-notes">Notes</label>
                <InputText id="rule-notes" class="form-control" @bind-Value="form.RuleNotes" />
            </div>
            <div class="form-text mb-2">
                Rules cannot be edited here. To correct a rule, delete it and add it again. Rules can be changed
                only until the version's first execution.
            </div>
            <button type="submit" class="btn btn-primary btn-sm" disabled="@saving">Add rule</button>
        </EditForm>
    </section>

    <ConfirmDialog Visible="deleting is not null" Title="Delete score rule?" ConfirmText="Delete" ConfirmClass="btn-danger"
                   Busy="saving" OnConfirm="DeleteAsync" OnCancel="() => deleting = null">
        @if (deleting is not null)
        {
            <p>
                <strong>@ReferenceData.PhaseName(deleting.PhaseID) · @ReferenceData.ScoreCategoryName(deleting.ScoreCategoryID)</strong>
                will be deleted.
            </p>
            <p class="mb-0">
                The rule is removed from this version. Its phase and category become free, so a new rule can be added for them.
            </p>
        }
    </ConfirmDialog>
}

@code {
    [Parameter, EditorRequired] public VersionConfiguration Configuration { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private ScoreRuleForm form = new();
    private ShepherdApi.ScoreRule? deleting;
    private ApiValidation? apiValidation;
    private ApiProblem? problem;
    private bool saving;

    private bool locked => Configuration.IsConfigurationFrozen;

    private VersionConfiguration? formBuiltFor;

    // Blazor note: OnParametersSet runs on every parent render, and a complex-typed parameter always
    // counts as changed. Rebuild the form only when the parent has actually reloaded the configuration,
    // so a half-filled form survives unrelated re-renders.
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(formBuiltFor, Configuration))
        {
            return;
        }

        formBuiltFor = Configuration;

        // The list holds every rule that occupies a pair (a deleted rule frees its pair, Issue #7).
        form = new ScoreRuleForm
        {
            ExistingPairs = Configuration.ScoreRules.Select(r => (r.PhaseID, r.ScoreCategoryID)).ToHashSet(),
            MinScore = 0,
            MaxScore = 5,
        };
    }

    private IEnumerable<(string PhaseName, List<ShepherdApi.ScoreRule> Rules)> Groups()
    {
        var phaseOrder = ReferenceData.Phases.Select((p, index) => (p.PhaseID, index)).ToDictionary(x => x.PhaseID, x => x.index);
        return Configuration.ScoreRules
            .GroupBy(r => r.PhaseID)
            .OrderBy(g => phaseOrder.GetValueOrDefault(g.Key, int.MaxValue))
            .Select(g => (ReferenceData.PhaseName(g.Key), g.ToList()));
    }

    private string Better(int scoreCategoryId) =>
        ReferenceData.ScoreCategories.FirstOrDefault(c => c.ScoreCategoryID == scoreCategoryId)?.HigherIsBetter switch
        {
            true => "higher",
            false => "lower",
            null => "?",
        };

    private async Task AddAsync()
    {
        saving = true;
        problem = null;
        try
        {
            await ScoreRules.ScoreRulesPostAsync(form.ToRequest(Configuration.Version.ExperimentVersionID));
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ApiErrorMapper.IsApiFailure(ex))
        {
            var mapped = Errors.Map(ex);
            if (mapped.Code == "duplicate-key")
            {
                // Another session added a rule for the pair after this list was loaded.
                mapped = mapped with { Detail = "This phase and category already have a rule in this version. Reload to see it." };
            }

            if (apiValidation?.TryShow(mapped) != true)
            {
                problem = mapped;
            }
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        saving = true;
        problem = null;
        try
        {
            await ScoreRules.ScoreRulesDeleteAsync(deleting!.ScoreRuleID);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ApiErrorMapper.IsApiFailure(ex))
        {
            problem = Errors.Map(ex);
        }
        finally
        {
            saving = false;
            deleting = null;
        }
    }
}
